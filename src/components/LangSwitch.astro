---
import { DEFAULT_LOCALE, localePath, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  /** 当前页面的语言 */
  locale: Locale;
  /**
   * 当前页面另一语言版本的真实路径；缺省表示该页暂无对应翻译，
   * 切换链接回落到另一语言的入口页，而不是造出一个 404。
   */
  alternateUrl?: string;
}

const { locale, alternateUrl } = Astro.props;
const targetLocale: Locale = locale === DEFAULT_LOCALE ? 'en' : DEFAULT_LOCALE;
const href = alternateUrl ?? (targetLocale === DEFAULT_LOCALE ? '/' : localePath('/', targetLocale));
const t = useTranslations(locale);
const label = t('langswitch.label');
---
<a
  href={href}
  class="rounded border border-slate-200 px-2 py-0.5 text-xs leading-5 text-slate-500 hover:border-slate-400 hover:text-slate-900"
  title={t('langswitch.title')}
  aria-label={t('langswitch.title')}
>{label}</a>
