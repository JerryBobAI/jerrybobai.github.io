---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---
<BaseLayout title={`页面不存在 · ${SITE.name}`} description="你访问的页面不存在或已移动。">
  <section class="flex flex-col items-center py-24 text-center">
    <p class="font-mono text-7xl font-bold tracking-tight text-slate-200">404</p>
    <h1 class="mt-6 text-2xl font-bold">页面漂出了数字海洋</h1>
    <p class="mt-3 max-w-md text-slate-600">你访问的页面不存在，或已随潮水移动到别处。</p>
    <div class="mt-8 flex gap-3">
      <a href="/" class="rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-slate-700">返回首页</a>
      <a href="/blog/" class="rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-medium transition-colors hover:border-slate-900">浏览文章</a>
    </div>
  </section>
</BaseLayout>
