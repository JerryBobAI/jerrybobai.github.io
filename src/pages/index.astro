---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import { notDraft, byDateDesc, formatDate } from '../lib/content';
import { tools } from '../data/tools';

const posts = (await getCollection('blog', notDraft)).sort(byDateDesc).slice(0, 3);
const projects = (await getCollection('projects', notDraft)).sort(byDateDesc).slice(0, 3);
const sortedTools = [...tools].sort((a, b) => (a.order ?? 99) - (b.order ?? 99)).slice(0, 3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    author: { '@type': 'Person', name: SITE.author, url: SITE.url },
  },
];
---
<BaseLayout title={SITE.name} description={SITE.description} jsonLd={jsonLd} width="wide">
  <section class="grid items-center gap-10 py-8 lg:grid-cols-2 lg:py-14">
    <div>
      <h1 class="text-4xl font-bold tracking-tight lg:text-5xl">{SITE.name}</h1>
      <p class="mt-4 text-lg leading-relaxed text-slate-600">{SITE.tagline}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/blog/" class="rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-slate-700">浏览文章</a>
        <a href="/docs/timeline/" class="rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-medium transition-colors hover:border-slate-900">文章归档</a>
      </div>
    </div>
    <div id="hero-figure" aria-hidden="true"></div>
  </section>

  <section aria-label="栏目精选" class="mt-6 grid gap-6 lg:grid-cols-3">
    <div class="rounded-xl border border-slate-200 p-6">
      <h2 class="text-lg font-bold">最新文章</h2>
      {posts.length === 0 && <p class="mt-4 text-sm text-slate-500">写作中，敬请期待。</p>}
      <ul class="mt-4 space-y-4">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="font-medium hover:underline">{post.data.title}</a>
            <p class="mt-1 line-clamp-2 text-sm text-slate-500">{formatDate(post.data.pubDate)} · {post.data.summary}</p>
          </li>
        ))}
      </ul>
      <a href="/blog/" class="mt-5 inline-block text-sm text-sky-700 hover:underline">查看全部 →</a>
    </div>

    <div class="rounded-xl border border-slate-200 p-6">
      <h2 class="text-lg font-bold">项目与产品</h2>
      {projects.length === 0 && <p class="mt-4 text-sm text-slate-500">项目整理中，敬请期待。</p>}
      <ul class="mt-4 space-y-4">
        {projects.map((p) => (
          <li>
            <a href={p.data.link ?? `/projects/#${p.id}`} class="font-medium hover:underline">{p.data.title}</a>
            <p class="mt-1 line-clamp-2 text-sm text-slate-500">{p.data.summary}</p>
          </li>
        ))}
      </ul>
      <a href="/projects/" class="mt-5 inline-block text-sm text-sky-700 hover:underline">查看全部 →</a>
    </div>

    <div class="rounded-xl border border-slate-200 p-6">
      <h2 class="text-lg font-bold">工具</h2>
      {sortedTools.length === 0 && <p class="mt-4 text-sm text-slate-500">工具制作中。每个工具独立成页，进入才加载交互代码。</p>}
      <ul class="mt-4 space-y-4">
        {sortedTools.map((t) => (
          <li>
            <a href={`/tools/${t.slug}/`} class="font-medium hover:underline">{t.title}</a>
            <p class="mt-1 line-clamp-2 text-sm text-slate-500">{t.description}</p>
          </li>
        ))}
      </ul>
      <a href="/tools/" class="mt-5 inline-block text-sm text-sky-700 hover:underline">查看全部 →</a>
    </div>
  </section>
</BaseLayout>

<script>
  import { terrain } from '@lucasmarkes/hairline';
  const el = document.getElementById('hero-figure');
  if (el) terrain(el as HTMLElement, { play: true });
</script>
