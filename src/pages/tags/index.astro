---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import { SITE } from '../../config/site';
import { notDraft } from '../../lib/content';

const posts = await getCollection('blog', notDraft);
const tagCount = new Map<string, number>();
for (const post of posts) {
  for (const t of post.data.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
}
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout width="wide" title={`标签 · ${SITE.name}`} description="按标签浏览全部文章。">
  <BackLink href="/" label="返回首页" />
  <h1 class="mt-4 text-3xl font-bold">标签</h1>
  <p class="mt-2 text-sm text-slate-500">共 {tags.length} 个标签，按文章数排序。</p>
  <div class="mt-6 flex flex-wrap gap-2">
    {tags.map(([t, n]) => (
      <a
        href={`/tags/${encodeURIComponent(t)}/`}
        class="rounded-full border border-slate-200 px-3 py-1 text-sm text-slate-600 transition-colors hover:border-slate-400 hover:text-slate-900"
      >
        #{t} <span class="text-slate-400">{n}</span>
      </a>
    ))}
  </div>
</BaseLayout>
