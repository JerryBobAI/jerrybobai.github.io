---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import { SITE } from '../../config/site';
import { notDraft, byDateDesc, formatDate } from '../../lib/content';

const posts = (await getCollection('blog', notDraft)).sort(byDateDesc);
---
<BaseLayout width="wide" title={`文章 · ${SITE.name}`} description="观点文章：原创为主，转载注明来源。" alternates={{ zh: '/blog/', en: '/en/blog/' }}>
  <BackLink href="/" label="返回首页" />
  <h1 class="mt-4 text-3xl font-bold">文章</h1>
  {posts.length === 0 && <p class="mt-6 text-slate-500">写作中，敬请期待。</p>}
  <div id="tag-filter-notice" class="mt-4 hidden items-center gap-2 text-sm text-slate-500">
    <span>筛选：<strong id="tag-filter-name" class="font-medium text-slate-900"></strong></span>
    <a href="/blog/" class="rounded-full border border-slate-200 px-2 py-0.5 text-xs hover:border-slate-400 hover:text-slate-900">清除</a>
  </div>
  <ul class="mt-8 grid gap-6 md:grid-cols-2">
    {posts.map((post) => (
      <li data-tags={post.data.tags.join(' ')}>
        <div class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-slate-200/70">
          <a href={`/blog/${post.id}/`} class="absolute inset-0" aria-label={post.data.title}>
            <span class="sr-only">{post.data.title}</span>
          </a>
          {post.data.cover && (
            <div class="pointer-events-none overflow-hidden border-b border-slate-200">
              <img
                src={post.data.cover}
                alt={`${post.data.title} 封面插图`}
                class="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                loading="lazy"
                width={900}
                height={600}
              />
            </div>
          )}
          <div class="flex flex-1 flex-col p-6">
            <p class="font-mono text-xs uppercase tracking-widest text-slate-400">
              {formatDate(post.data.pubDate)} · {post.data.origin}
            </p>
            <h3 class="mt-3 text-xl font-bold leading-snug transition-colors duration-300 group-hover:text-sky-700">
              {post.data.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600 line-clamp-3">{post.data.summary}</p>
            <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-5">
              {post.data.tags.map((t) => (
                <a
                  href={`/tags/${encodeURIComponent(t)}/`}
                  class="relative z-10 rounded-full bg-slate-100 px-2.5 py-0.5 text-xs text-slate-500 transition-colors hover:bg-slate-200 hover:text-slate-900"
                >#{t}</a>
              ))}
              <span class="ml-auto inline-flex items-center gap-1.5 text-sm font-medium text-slate-900 transition-colors duration-300 group-hover:text-sky-700">
                阅读
                <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
              </span>
            </div>
          </div>
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>
<script>
  // 支持 /blog/?tag=xx 客户端过滤（文章页关键词链入）
  const tag = new URLSearchParams(location.search).get('tag');
  if (tag) {
    const items = document.querySelectorAll<HTMLLIElement>('li[data-tags]');
    let shown = 0;
    items.forEach((li) => {
      const hit = (li.dataset.tags ?? '').split(' ').includes(tag);
      li.style.display = hit ? '' : 'none';
      if (hit) shown++;
    });
    document.getElementById('tag-filter-name').textContent = `#${tag}`;
    const notice = document.getElementById('tag-filter-notice');
    notice.classList.remove('hidden');
    notice.classList.add('flex');
    if (shown === 0) {
      const empty = document.createElement('p');
      empty.className = 'mt-6 text-slate-500';
      empty.textContent = `没有标签为 #${tag} 的文章。`;
      notice.after(empty);
    }
  }
</script>
