---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import { SITE } from '../../config/site';
import { notDraft, byDateDesc, formatDate } from '../../lib/content';

const entries = (await getCollection('projects', notDraft)).sort(byDateDesc);
const KINDS = ['实战项目', '在线产品'] as const;
---
<BaseLayout width="wide" title={`项目 · ${SITE.name}`} description="实战项目与在线产品，产品外链直达，欢迎反链回来。">
  <BackLink href="/" label="返回首页" />
  <h1 class="mt-4 text-3xl font-bold">项目</h1>
  {entries.length === 0 && <p class="mt-6 text-slate-500">项目整理中，敬请期待。</p>}
  {KINDS.map((kind) => {
    const group = entries.filter((e) => e.data.kind === kind);
    if (group.length === 0) return null;
    return (
      <section class="mt-8">
        <h2 class="text-xl font-bold">{kind}</h2>
        <ul class="mt-4 grid gap-6 md:grid-cols-2">
          {group.map((e) => {
            const body = (
              <>
                {e.data.cover && (
                  <div class="overflow-hidden border-b border-slate-200">
                    <img
                      src={e.data.cover}
                      alt={`${e.data.title} 界面预览`}
                      class="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                      loading="lazy"
                      width={900}
                      height={600}
                    />
                  </div>
                )}
                <div class="flex flex-1 flex-col p-6">
                  <p class="text-xs font-medium uppercase tracking-widest text-slate-400">
                    {e.data.status} · {formatDate(e.data.pubDate)}
                  </p>
                  <h3 class="mt-2 text-xl font-bold">{e.data.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-slate-600">{e.data.summary}</p>
                  {e.data.stats.length > 0 && (
                    <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-slate-500">
                      {e.data.stats.map((s) => <li>{s}</li>)}
                    </ul>
                  )}
                  {e.data.link && (
                    <p class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-medium text-slate-900 transition-colors group-hover:text-sky-700">
                      {e.data.cta ?? '查看详情'}
                      <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
                    </p>
                  )}
                </div>
              </>
            );
            const classes =
              'group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-slate-200/70';
            return (
              <li>
                {e.data.link
                  ? <a href={e.data.link} class={`${classes} block`}>{body}</a>
                  : <div class={classes}>{body}</div>}
              </li>
            );
          })}
        </ul>
      </section>
    );
  })}
</BaseLayout>
