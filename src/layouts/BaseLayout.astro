---
import BaseHead from '../components/BaseHead.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  /** wide：栏目页/首页 max-w-6xl；narrow（默认）：长文正文 max-w-3xl */
  width?: 'narrow' | 'wide';
}

const { title, description, jsonLd = [], width = 'narrow' } = Astro.props;
const containerMax = width === 'wide' ? 'max-w-6xl' : 'max-w-3xl';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <BaseHead title={title} description={description} />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body class="min-h-screen bg-white text-slate-900 antialiased">
    <SiteNav />
    <main class={`mx-auto ${containerMax} px-4 py-10`}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
